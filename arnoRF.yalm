

status_led:
  pin:
    number: GPIO13
    inverted: true

remote_transmitter:
  id: rf_tx
  pin: GPIO5
  carrier_duty_percent: 50%

text:
  - platform: template
    name: "ARNO - DIP (binário)"
    id: arno_dip_bin
    icon: mdi:dip-switch
    mode: text
    min_length: 4
    max_length: 4
    initial_value: "0001"
    restore_value: true
    optimistic: true

script:
  - id: arno_enviar_captura
    mode: queued
    parameters:
      comando: int
    then:
      - if:
          condition:
            lambda: |-
              const std::string dip = id(arno_dip_bin).state;
              if (dip.size() != 4) return false;
              for (char bit : dip) {
                if (bit != '0' && bit != '1') return false;
              }
              return comando == 0 ||
                  comando == 1 ||
                  comando == 2 ||
                  comando == 3 ||
                  comando == 6 ||
                  comando == 7 ||
                  comando == 8 ||
                  comando == 17 ||
                  comando == 34 ||
                  comando == 50 ||
                  comando == 68 ||
                  comando == 80 ||
                  comando == 81 ||
                  comando == 82 ||
                  comando == 84 ||
                  comando == 86 ||
                  comando == 104 ||
                  comando == 112 ||
                  comando == 113;
          then:
            - remote_transmitter.transmit_raw:
                transmitter_id: rf_tx
                code: !lambda |-
                              const std::string dip = id(arno_dip_bin).state;
                              if (dip.size() != 4) return std::vector<int32_t>{};
