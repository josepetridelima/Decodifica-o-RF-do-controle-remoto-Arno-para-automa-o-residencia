                                  resultado.insert(resultado.end(), cabecalho.begin() + base_cabecalho, cabecalho.begin() + base_cabecalho + 24);
                                  for (size_t bit = 0; bit < 4; bit++) {
                                    const size_t base_pulso = base_cabecalho + (dip[bit] == '0' ? 24 : 30);
                                    resultado.push_back(cabecalho[base_pulso]);
                                    resultado.push_back(cabecalho[base_pulso + 1]);
                                  }
                                  resultado.insert(resultado.end(), captura.begin() + base_comando + 32, captura.begin() + base_comando + 48);
                                }
                                return resultado;
                              };

