                                                                  -894, 1087, -896, 1083, -874, 1101, -891, 1095,
                                                                  -1390, 610, -1414, 608, -1384, 632, -383, 1606,
                                                                  -406, 1606, -406, 1603, -406, 1603, -1406, 605,
                                                                  -1407, 604, -1407, 603, -405, 1603, -1406, 606,
                                                                  -402, 1603, -405, 1604, -406, 1603, -1409, 4535,
                                                                  -895, 1085, -899, 1077, -880, 1095, -884, 1093,
                                                                  -909, 1091, -883, 1090, -878, 1105, -871, 1111,
                                                                  -1394, 619, -1396, 595, -1400, 624, -377, 1627,
                                                                  -404, 1604, -404, 1604, -405, 1604, -1404, 603,
                                                                  -1405, 603, -1406, 603, -405, 1603, -1406, 604,
                                                                  -405, 1604, -405, 1603, -406, 1605, -1405, 6591
                                                              });
                                                            }

                              // Velocidade 6 — DIP 0001, sequência capturada em Configurar Decodificador RF (8)
                              
                              if (comando == 112) {
                                                              return montar(std::vector<int32_t>{
                                                                  -899, 1085, -894, 1086, -894, 1085, -875, 1102,
                                                                  -881, 1096, -891, 1094, -884, 1100, -877, 1082,
                                                                  -1420, 596, -1400, 624, -1379, 626, -403, 1603,
                                                                  -403, 1603, -405, 1603, -405, 1604, -1407, 602,
                                                                  -1407, 603, -1408, 601, -1405, 603, -405, 1603,
                                                                  -405, 1603, -405, 1603, -405, 1604, -1408, 4509,
                                                                  -898, 1079, -903, 1071, -890, 1093, -888, 1098,
                                                                  -879, 1104, -871, 1110, -868, 1112, -870, 1109,
                                                                  -1402, 601, -1400, 599, -1413, 616, -393, 1618,
                                                                  -394, 1596, -400, 1624, -378, 1626, -1404, 606,
                                                                  -1402, 603, -1407, 602, -1406, 603, -404, 1603,
                                                                  -405, 1603, -404, 1606, -403, 1604, -1405, 6586
                                                              });
                                                            }

                              // Brisa — DIP 0001, sequência capturada em Configurar Decodificador RF (16)
                              
                              if (comando == 113) {
                                                              return montar(std::vector<int32_t>{
                                                                  -878, 1090, -894, 1086, -894, 1085, -898, 1076,
                                                                  -904, 1070, -912, 1064, -911, 1090, -884, 1100,
                                                                  -1378, 625, -1405, 602, -1404, 602, -405, 1604,
                                                                  -403, 1604, -405, 1604, -405, 1604, -1407, 604,
                                                                  -1407, 602, -1407, 601, -1405, 603, -404, 1604,
                                                                  -405, 1604, -406, 1603, -1408, 603, -404, 5483,
                                                                  -902, 1071, -909, 1092, -886, 1091, -883, 1092,
                                                                  -878, 1089, -900, 1091, -872, 1109, -895, 1086,
                                                                  -1397, 619, -1396, 595, -1419, 595, -398, 1624,
                                                                  -376, 1626, -403, 1603, -405, 1603, -1407, 606,
                                                                  -1401, 603, -1406, 603, -1405, 603, -405, 1603,
                                                                  -405, 1605, -405, 1605, -1406, 602, -405, 5483
                                                              });
                                                            }

                              return std::vector<int32_t>{};
          else:
            - logger.log:
                level: WARN
                format: "DIP inválido ou comando indisponível; transmissão cancelada."

